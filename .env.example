# Base URL da API do Agnus (backend direto, SEM o prefixo /api do nginx do web).
# Rotas ficam na raiz: ${EXPO_PUBLIC_API_URL}/products/catalog, /auth/login, etc.
#
# iOS simulator / web ........ http://localhost:3000
# Android emulator ........... http://10.0.2.2:3000
# Device fisico .............. http://<IP-da-sua-maquina>:3000
# Producao .................. https://api.agnus.com (confirmar com o time)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Login com Google (opcional). Sem estas variaveis o botao "Continuar com
# Google" nao aparece. Exige dev build (nao roda no Expo Go). Crie os OAuth
# clients no Google Cloud Console. Veja o README.
# - Web client ID: gera o id_token enviado ao backend
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# - iOS client ID + o "iOS URL scheme" dele (reversed client ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
