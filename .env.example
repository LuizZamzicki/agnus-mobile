# Base URL da API do Agnus, sempre pelo gateway (nginx). As rotas ficam abaixo
# dela: ${EXPO_PUBLIC_API_URL}/products/catalog, /auth/login, etc.
#
# Celular, emulador ou simulador (desenvolvimento): use o ngrok da stack
# (servico `ngrok` do docker-compose, dominio em NGROK_DOMAIN). A entrada do
# tunel ja acrescenta o /api, entao a URL e a RAIZ do dominio, sem /api:
#   https://<seu-dominio>.ngrok-free.dev
#
# Gateway HTTPS (navegador na mesma maquina, `npx expo start --web`):
#   https://localhost/api
# O celular nao aceita o certificado do mkcert, e a porta 80 so redireciona para
# HTTPS: por isso o ngrok no desenvolvimento.
#
# Producao: https://<dominio-do-gateway>/api (definir com o time; ver eas.json).
EXPO_PUBLIC_API_URL=https://<seu-dominio>.ngrok-free.dev

# Botao "Continuar com Google" no login (ligado por padrao). Use =false pra
# esconder quando o backend nao tiver o Google OAuth configurado no ambiente.
# O fluxo e web (expo-auth-session) e roda no Expo Go; o backend precisa aceitar
# o redirect do app (ver README).
# EXPO_PUBLIC_GOOGLE_LOGIN=false
